#!/usr/bin/env python3
"""Forward NDJSON lines from stdin to stdout with a hard per-line byte cap."""
from __future__ import annotations

import sys

MAX_LINE_BYTES = 524_288
READ_CHUNK = 8192


def main() -> int:
    buffer = bytearray()
    while True:
        chunk = sys.stdin.buffer.read(READ_CHUNK)
        if not chunk:
            break
        buffer.extend(chunk)
        while True:
            newline = buffer.find(b"\n")
            if newline < 0:
                break
            line = buffer[:newline]
            del buffer[: newline + 1]
            if len(line) > MAX_LINE_BYTES:
                sys.stderr.write("ndjson-line-relay: line exceeds limit\n")
                return 1
            sys.stdout.buffer.write(line + b"\n")
            sys.stdout.buffer.flush()
        if len(buffer) > MAX_LINE_BYTES:
            sys.stderr.write("ndjson-line-relay: line exceeds limit\n")
            return 1
    if buffer:
        if len(buffer) > MAX_LINE_BYTES:
            sys.stderr.write("ndjson-line-relay: line exceeds limit\n")
            return 1
        sys.stdout.buffer.write(buffer)
        sys.stdout.buffer.flush()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
